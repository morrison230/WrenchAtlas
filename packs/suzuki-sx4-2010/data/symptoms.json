{
  "schema_version": "0.1",
  "note": "症状索引：把「用户说的话」映射到「哪个系统 + 第一刀往哪切」。所有分支均来自已有 circuits 数据的 diagnosis_hint，非新增推测。",
  "symptoms": [
    {
      "id": "no-crank",
      "label": "打不着火 · 起动机不转",
      "aka": [
        "拧钥匙没反应",
        "起动机不转",
        "打火没声音",
        "打不着",
        "不着车",
        "打火没反应",
        "拧钥匙没动静",
        "启动不了"
      ],
      "first_question": "拧钥匙时，能听到『哒』一声吗？",
      "branches": [
        {
          "when": "完全没声音，也没有『哒』",
          "verdict": "控制回路断",
          "check": "依次查：JB ST SIG 10A 保险丝 → 点火开关 ST 接点 → 起动机继电器线圈",
          "circuits": [
            "starting"
          ]
        },
        {
          "when": "有『哒』一声，但起动机不转",
          "verdict": "控制回路正常，主回路有问题",
          "check": "查：继电器触点、起动机电磁开关、ST 30A 熔丝、蓄电池到起动机的大电流线",
          "circuits": [
            "starting"
          ]
        },
        {
          "when": "连续『哒哒哒』，声音越来越弱",
          "verdict": "蓄电池电量不足",
          "check": "不是起动机坏。先充电或搭电，再查充电系统",
          "circuits": [
            "starting",
            "charging"
          ]
        },
        {
          "when": "自动挡，D 档或 R 档拧钥匙没反应",
          "verdict": "正常现象",
          "check": "只有 P/N 档才能起动。挂 P 档再试",
          "circuits": [
            "starting"
          ]
        }
      ],
      "also_check": "如果起动机转但发动机不着，转「起动机转但不点火」"
    },
    {
      "id": "crank-no-start",
      "label": "起动机转，但发动机不着",
      "aka": [
        "打火有声但不着车",
        "空转",
        "有声音不着",
        "干转不着",
        "打火不启动",
        "空转不着车"
      ],
      "first_question": "转速表指针动不动？",
      "branches": [
        {
          "when": "转速表完全不动",
          "verdict": "CKP 曲轴位置传感器无信号",
          "check": "最高优先级：查 CKP（C31.2 粉红线 → ECM C01 21）。无 CKP 信号则 ECM 不喷油不点火",
          "circuits": [
            "engine-ecm"
          ]
        },
        {
          "when": "转速表正常摆动，但不着车",
          "verdict": "在油或火",
          "check": "查点火（15A IG COIL、点火线圈）与喷油（主继电器、四缸公共电源）",
          "circuits": [
            "ignition",
            "engine-ecm"
          ]
        },
        {
          "when": "冷车好着、热车不好着",
          "verdict": "多为起动机电磁开关或搭铁",
          "check": "查起动机电磁开关与搭铁，不是蓄电池问题",
          "circuits": [
            "starting"
          ]
        }
      ]
    },
    {
      "id": "misfire",
      "label": "怠速抖动 / 单缸失火",
      "aka": [
        "抖",
        "发动机抖",
        "P0301",
        "失火",
        "冷车抖",
        "热车抖",
        "怠速不稳",
        "抖车",
        "发动机不稳",
        "缺缸",
        "喘"
      ],
      "first_question": "有故障码吗？是哪一个缸？",
      "branches": [
        {
          "when": "报 P0301 或 P0304（1 缸或 4 缸）",
          "verdict": "若两缸同时报 → 点火线圈 C101 坏",
          "check": "废火花系统：C101 管 1&4 缸。两缸同时失火基本可判定线圈坏，不用怀疑两个火花塞同时挂",
          "circuits": [
            "ignition",
            "engine-ecm"
          ]
        },
        {
          "when": "报 P0302 或 P0303（2 缸或 3 缸）",
          "verdict": "若两缸同时报 → 点火线圈 C102 坏",
          "check": "C102 管 2&3 缸",
          "circuits": [
            "ignition",
            "engine-ecm"
          ]
        },
        {
          "when": "只有单缸失火",
          "verdict": "优先火花塞",
          "check": "废火花系统里线圈坏了必是两缸同时，所以单缸先换火花塞与高压线。喷油器故障率低于点火",
          "circuits": [
            "ignition",
            "engine-ecm"
          ]
        },
        {
          "when": "四缸同时失火",
          "verdict": "不是喷油器问题",
          "check": "查主继电器、喷油器公共电源黑线、CKP 信号",
          "circuits": [
            "engine-ecm"
          ]
        },
        {
          "when": "怠速抖 + 加速无力 + 没有故障码",
          "verdict": "先查电子节气门积碳",
          "check": "查节气门 C48 与 TP 传感器。不是传感器坏了才报码，积碳先抖",
          "circuits": [
            "engine-ecm"
          ]
        }
      ]
    },
    {
      "id": "no-charge",
      "label": "不充电 / 电瓶灯亮",
      "aka": [
        "电瓶灯",
        "充电灯亮",
        "老是没电",
        "充电灯",
        "电瓶不充电",
        "老是亏电",
        "打不着电瓶"
      ],
      "first_question": "电瓶灯是一直亮，还是不亮也不充电？",
      "branches": [
        {
          "when": "电瓶灯常亮，完全不充电",
          "verdict": "主回路",
          "check": "先查主保险丝 43·80A，再查发电机 B+ 粗线、皮带是否打滑断裂",
          "circuits": [
            "charging"
          ]
        },
        {
          "when": "电瓶灯不亮，但就是不充电",
          "verdict": "励磁回路",
          "check": "查 15A IG COIL 保险丝与励磁回路。C312 压接点常是接触不良点",
          "circuits": [
            "charging"
          ]
        },
        {
          "when": "换新电瓶很快又没电",
          "verdict": "若充电正常，是漏电",
          "check": "测静态电流。不属充电系统，别继续查发电机",
          "circuits": [
            "charging"
          ]
        },
        {
          "when": "冷车正常、热车不充电",
          "verdict": "调节器热衰减",
          "check": "发电机内部 IC 调节器，需换总成",
          "circuits": [
            "charging"
          ]
        }
      ]
    },
    {
      "id": "headlamp-dark",
      "label": "大灯不亮",
      "aka": [
        "灯不亮",
        "大灯坏了",
        "晚上看不见",
        "大灯坏",
        "晚上看不见路",
        "近光不亮",
        "远光不亮",
        "一个灯亮一个不亮"
      ],
      "first_question": "左右两侧都不亮，还是只有一侧？",
      "branches": [
        {
          "when": "左右都不亮",
          "verdict": "不是灯泡问题",
          "check": "查 DOME 15A（BCM 供电）与灯光开关 G144",
