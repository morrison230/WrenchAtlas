        },
        {
          "when": "只有一侧不亮",
          "verdict": "该侧独立回路",
          "check": "该侧保险丝（HL L 或 HL R）→ 该侧继电器（E151/E152）→ 灯泡，三步递进",
          "circuits": [
            "headlamp"
          ]
        },
        {
          "when": "只有近光或只有远光不亮",
          "verdict": "双灯丝灯泡",
          "check": "类型 I 为远近光一体灯泡，一根灯丝断了，换灯泡即可",
          "circuits": [
            "headlamp"
          ]
        },
        {
          "when": "大灯常亮关不掉",
          "verdict": "继电器或 BCM",
          "check": "触点粘连或 BCM 输出卡死，先拔继电器止亮",
          "circuits": [
            "headlamp"
          ]
        }
      ]
    },
    {
      "id": "turn-fail",
      "label": "转向灯不亮 / 闪得快",
      "aka": [
        "转向灯",
        "双闪",
        "打转向不闪",
        "打转向不亮",
        "双闪坏了",
        "转向不工作",
        "闪得快"
      ],
      "first_question": "双闪（危险警告灯）正常吗？",
      "branches": [
        {
          "when": "转向灯不闪，但双闪正常",
